# =====================================================
# MyTeam 环境配置模板（示例）
# 用法：
#   - 服务器 / Docker Compose 部署：复制本文件为 .env 并填写
#   - 本地开发：复制本文件为 .env.local 并填写
# 请勿提交真实密钥（.env / .env.local 已在 .gitignore 中）。
# =====================================================

# ---------- AI 对话模型 ----------
# Kimi（月之暗面）
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k2.6
# 图片视觉输入：留空=按模型自动判断（k3/k2.7-code/k2.6 默认开启）；
# true/1 强制开启，false 强制关闭（关闭后图片走文本降级提示）
KIMI_IMAGE_INPUT=

# DeepSeek（官方 API 仅文本模型，不支持图片输入）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# 图片视觉输入：留空=关闭（官方模型不支持）；仅当你接入支持视觉的模型/网关时才设为 true
DEEPSEEK_IMAGE_INPUT=

# ---------- 附件 ----------
# 单文件最大体积（MB，默认 20）；单条消息最大附件数（默认 5）
ATTACHMENT_MAX_FILE_MB=20
ATTACHMENT_MAX_COUNT=5

# ---------- MySQL / MariaDB 数据库 ----------
# 服务器上数据库的连接信息；全部留空 = 使用本地模式（浏览器 localStorage）。
# 库名：DB_NAME（默认 myteam）；表：employees / messages / settings（启动时自动创建）
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password
DB_NAME=myteam
